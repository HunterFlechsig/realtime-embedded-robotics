/**
 * Blink the onboard LED with two timers. One turns the LED on every 250 ms.
 * The other turns it off 250 ms later.
 *
 * @author Hunter Flechsig
 */
target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true
}

preamble {=
  #include <stdio.h>
  #include <pico/stdlib.h>
  #include <hardware/gpio.h>
=}

main reactor {
  timer on(0, 250 ms)
  timer off(250 ms, 250 ms)

  reaction(startup) {=
    gpio_init(PICO_DEFAULT_LED_PIN);
    gpio_set_dir(PICO_DEFAULT_LED_PIN, GPIO_OUT);
  =}

  reaction(off) {=
    gpio_put(PICO_DEFAULT_LED_PIN, false);
    
  =}

  reaction(on) {=
    gpio_put(PICO_DEFAULT_LED_PIN, true);
  =}
}
