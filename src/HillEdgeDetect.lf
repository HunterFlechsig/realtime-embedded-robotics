/**
 * Classify the five downward reflectance sensors as LEFT, MIDDLE, or RIGHT.
 *
 * The first 10 seconds are calibration. Roll the robot over the light surface
 * and the dark edge. After that, a calibrated reading above 200 is treated as
 * dark. More than one label can be shown at once.
 *
 * @author Hunter Flechsig
 */
target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true
}

import Line from "lib/Line.lf"
import Display from "lib/Display.lf"

main reactor(calibration_time: time = 10 s, sample_period: time = 100 ms) {
  line = new Line()
  disp = new Display()

  timer t(0, sample_period)
  timer seconds(0, 1 s)
  timer end_calibration(calibration_time)
  state count: int = 0

  reaction(startup) -> disp.line0, disp.line1, disp.line2 {=
    lf_set(disp.line0, "CALIBRATING");
    lf_set(disp.line1, "Roll robot over");
    lf_set(disp.line2, "light and dark.");
  =}

  reaction(seconds) -> disp.line3 {=
    static char buf[17];
    snprintf(buf, 17, "time:%8d s", self->count++);
    lf_set(disp.line3, buf);
  =}

  reaction(end_calibration) -> line.calibrate {=
    lf_set(line.calibrate, false);
  =}

  reaction(t) -> line.trigger {=
    lf_set(line.trigger, true);
  =}

  reaction(line.reflect) -> disp.line0, disp.line1, disp.line2 {=
    static char buf0[17];
    static char buf1[17];
    static char buf2[17];

    if (line.reflect->value[0] > 200 || line.reflect->value[1] > 200) {
      snprintf(buf0, 17, "LEFT");
    } else {
      snprintf(buf0, 17, "");
    }

    if (line.reflect->value[1] > 200 || line.reflect->value[2] > 200 || line.reflect->value[3] > 200) {
      snprintf(buf1, 17, "MIDDLE");
    } else {
      snprintf(buf1, 17, "");
    }

    if (line.reflect->value[3] > 200 || line.reflect->value[4] > 200) {
      snprintf(buf2, 17, "RIGHT");
    } else {
      snprintf(buf2, 17, "");
    }

    lf_set(disp.line0, buf0);
    lf_set(disp.line1, buf1);
    lf_set(disp.line2, buf2);
  =}
}
